# Copy this file to .env and adjust for your environment. Never commit a real .env file.

# Network
PORT=8787
HOST=0.0.0.0

# Comma-separated list of origins allowed to call this API (the web app's origin in production).
CORS_ORIGIN=http://localhost:4321

# Set to true only when running behind a trusted reverse proxy (nginx, etc.)
# that sets X-Forwarded-* headers. Required for rate limiting to see real client IPs correctly.
TRUST_PROXY=false

# Bounded concurrency: each image job runs in its own worker_threads worker,
# enforced from the moment a request starts reading its upload (not just
# during the Sharp call), so buffered-upload memory is bounded the same way.
MAX_CONCURRENT_JOBS=2
MAX_QUEUE_LENGTH=10

# Hard per-job timeout. On expiry, the worker running that job is forcibly
# terminated (worker.terminate(), awaited) before capacity is released —
# a hung job can never hold a slot past this.
JOB_TIMEOUT_MS=20000

# Upper bound on graceful shutdown before force-terminating any remaining
# workers and exiting anyway, so a stuck connection can't hang a restart.
SHUTDOWN_TIMEOUT_MS=10000

# Per-IP rate limiting.
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# Temporary file storage. Not used in normal operation — image processing is
# entirely in-memory inside an isolated worker thread, and nothing is written
# to disk during normal operation. This directory and sweep exist purely as a
# defensive safety net in case a future change ever leaves a stray file here.
# TEMP_DIR=/var/lib/toolmetric/tmp
TEMP_FILE_MAX_AGE_MS=600000
CLEANUP_INTERVAL_MS=300000

LOG_LEVEL=info
NODE_ENV=development
