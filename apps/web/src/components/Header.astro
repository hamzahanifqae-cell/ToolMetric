---
import { CATEGORIES, TOOLS } from "../content/tools.js";
import { siteConfig } from "../config/site.js";
const navItems = Object.values(CATEGORIES);
const labels = {image:'Image tools', calculators:'Calculators', converters:'Converters', electrical:'Electrical'};
---
<header class="site-header">
  <div class="nav-shell">
    <a href="/" class="brand" aria-label={`${siteConfig.name} home`}><span class="brand-mark" aria-hidden="true">t<span>m</span></span>{siteConfig.name}<span class="brand-dot">.</span></a>
    <nav aria-label="Primary" class="desktop-nav">
      {navItems.map(cat => <details class="nav-dropdown"><summary class:list={[{active:Astro.url.pathname.startsWith(cat.path)}]}>{labels[cat.key]}<span aria-hidden="true">⌄</span></summary><div class="dropdown-panel"><p class="dropdown-label">{cat.label}</p>{TOOLS.filter(t=>t.category===cat.key).map(tool=><a href={tool.path} aria-current={Astro.url.pathname===tool.path ? 'page' : undefined}>{tool.title}<span aria-hidden="true">↗</span></a>)}<a class="dropdown-all" href={cat.path}>Explore this category →</a></div></details>)}
    </nav>
    <div class="nav-actions">
    <details class="nav-search">
      <summary aria-label="Search tools"><svg aria-hidden="true" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 4 4"/></svg><span>Search</span></summary>
      <div class="nav-search-panel"><label for="nav-tool-search">Find your tool</label><input id="nav-tool-search" type="search" placeholder="Search tools…" autocomplete="off" /><p class="nav-search-count" aria-live="polite"></p><ul>{TOOLS.map(tool=><li data-tool-search={[tool.title,...tool.keywords].join(' ').toLowerCase()}><a href={tool.path}>{tool.title}<span aria-hidden="true">→</span></a></li>)}</ul><p class="nav-search-empty" hidden>No tools found. Try another search.</p></div>
    </details>
    <a href="/tools" class="nav-cta">All tools <span aria-hidden="true">↗</span></a>
    <details class="mobile-nav"><summary aria-label="Toggle navigation">Menu <span aria-hidden="true">☰</span></summary><nav aria-label="Mobile tools">{navItems.map(cat=><details><summary>{cat.label}</summary><a href={cat.path}>All {labels[cat.key].toLowerCase()} →</a>{TOOLS.filter(t=>t.category===cat.key).map(t=><a href={t.path}>{t.title}</a>)}</details>)}<a href="/tools">Browse all tools →</a></nav></details>
    </div>
  </div>
  <div class="quick-nav"><nav aria-label="Quick tools"><span>QUICK ACCESS</span><a href="/tools/image/compressor">Compress image</a><a href="/tools/calculators/percentage">Percentage</a><a href="/tools/converters/length">Length converter</a><a href="/tools/electrical/ohms-law">Ohm’s law</a><a href="/tools/calculators/age">Age calculator</a></nav></div>
</header>
<script is:inline>
const dropdowns = [...document.querySelectorAll('.nav-dropdown')];
for (const dropdown of dropdowns) {
 let closeTimer;
 dropdown.addEventListener('pointerenter', event => {
  if (event.pointerType !== 'mouse' || !window.matchMedia('(hover: hover)').matches) return;
  clearTimeout(closeTimer);
  for (const other of dropdowns) if (other !== dropdown) other.open = false;
  dropdown.open = true;
 });
 dropdown.addEventListener('pointerleave', event => {
  if (event.pointerType !== 'mouse') return;
  clearTimeout(closeTimer);
  closeTimer = setTimeout(() => {
   if (!dropdown.matches(':hover') && !dropdown.contains(document.activeElement)) dropdown.open = false;
  }, 180);
 });
 dropdown.addEventListener('focusout', event => {
  if (!(event.relatedTarget instanceof Node) || !dropdown.contains(event.relatedTarget)) dropdown.open = false;
 });
 dropdown.addEventListener('toggle', () => { if (dropdown.open) for (const other of dropdowns) if (other !== dropdown) other.open = false; });
}
document.addEventListener('click', event => { for (const menu of document.querySelectorAll('.nav-dropdown, .mobile-nav, .nav-search')) if (event.target instanceof Node && !menu.contains(event.target)) menu.open = false; });
document.addEventListener('keydown', event => { if (event.key === 'Escape') for (const menu of document.querySelectorAll('.nav-dropdown[open], .mobile-nav[open], .nav-search[open]')) { menu.open = false; menu.querySelector('summary')?.focus(); } });
const searchMenu = document.querySelector('.nav-search');
const searchInput = document.querySelector('#nav-tool-search');
const searchRows = [...document.querySelectorAll('[data-tool-search]')];
const searchCount = document.querySelector('.nav-search-count');
const searchEmpty = document.querySelector('.nav-search-empty');
function filterTools() {
 const query = searchInput?.value.trim().toLowerCase() || '';
 let count = 0;
 for (const row of searchRows) { row.hidden = !row.dataset.toolSearch?.includes(query); if (!row.hidden) count++; }
 if (searchCount) searchCount.textContent = `${count} ${count === 1 ? 'tool' : 'tools'} available`;
 if (searchEmpty) searchEmpty.hidden = count > 0;
}
searchInput?.addEventListener('input', filterTools);
searchMenu?.addEventListener('toggle', () => {
 if (searchMenu.open) { for (const menu of dropdowns) menu.open = false; filterTools(); searchInput?.focus(); }
});
filterTools();
</script>

<style>
/* Keep the pointer inside the menu while crossing its visual gap. */
.dropdown-panel::before { content: ''; position: absolute; top: -14px; left: 0; right: 0; height: 14px; }
</style>
