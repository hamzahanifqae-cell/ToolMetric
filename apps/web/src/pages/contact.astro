---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../config/site.js";
import { breadcrumbJsonLd } from "../lib/structuredData.js";
---

<BaseLayout
  title="Contact"
  description={`Contact ${siteConfig.name}. The site is published by ${siteConfig.operatorName}. Email ${siteConfig.operatorEmail}.`}
  jsonLd={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Contact" }], siteConfig.url)]}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: "Home", path: "/" }, { label: "Contact" }]} />
    <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">Contact</h1>

    <div class="prose-tool mt-6">
      <h2>Publisher</h2>
      <p>{siteConfig.name} is published by {siteConfig.operatorName}.</p>

      <h2>Email</h2>
      {
        siteConfig.operatorEmail ? (
          <p>
            <a href={`mailto:${siteConfig.operatorEmail}`} class="font-semibold text-teal-700 underline">
              {siteConfig.operatorEmail}
            </a>
          </p>
        ) : (
          <p>No public email address is listed.</p>
        )
      }
      <p>This page does not include a contact form, and it does not store a message.</p>

      <h2>Reporting a problem with a tool</h2>
      <p>If a result looks wrong or a tool does not work, an email that includes these details is easier to check:</p>
      <ul>
        <li>The address of the tool page.</li>
        <li>The values you entered, or for an image tool the file type, pixel size, and the options you chose.</li>
        <li>The result you got and the result you expected.</li>
        <li>Your browser and device, and for an image tool whether "Process on your device" or the server upload was selected.</li>
      </ul>
      <p>
        You do not need to attach your image. If you do attach one, it goes to the publisher's mailbox as an ordinary
        email attachment. The file-handling rules in the privacy policy cover the image tools, not email.
      </p>

      <h2>Privacy questions</h2>
      <p>
        The <a href="/privacy/">privacy policy</a> explains what the calculators, image tools, analytics, and ads do with
        your data. The site has no accounts, so there is no profile to look up. Say which page or tool your question is
        about. Google's ad settings can be changed in{" "}
        <a href="https://myadcenter.google.com/" class="font-semibold text-teal-700 underline">Google's Ad Center</a>.
      </p>

      <h2>Copyright or other rights concerns</h2>
      <p>
        If you think something published on this site infringes your rights, email the page address, the specific
        text or image concerned, and how you are connected to the rights. Files processed by the image tools are not
        stored or published by the site, so they are not part of its content.
      </p>

      <p>
        More about who runs the site is on the <a href="/about/">about page</a>. How visits, ads, and files are handled
        is in the <a href="/privacy/">privacy policy</a>.
      </p>
    </div>
  </div>
</BaseLayout>
