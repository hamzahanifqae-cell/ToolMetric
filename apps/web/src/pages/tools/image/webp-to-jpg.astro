---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { ConvertImageTool } from "../../../components/image/ConvertImageTool.js";
import { getToolByPath } from "../../../content/tools.js";

const tool = getToolByPath("/tools/image/webp-to-jpg")!;
---

<ToolLayout
  tool={tool}
  purpose="Convert a WebP file to JPG. Choose a background color to fill transparent areas, since JPG does not support transparency."
>
  <ConvertImageTool client:load acceptAttr="image/webp" acceptedLabel="WebP" outputFormat="jpeg" />

  <Fragment slot="details">
    <h2>How it works</h2>
    <p>
      Select a WebP file. It's decoded in your browser, flattened onto your chosen background color, and re-encoded
      as JPG — nothing is uploaded unless you switch to the server option.
    </p>

    <h2>Worked example</h2>
    <p>
      A WebP product photo with a transparent corner, converted with a white background, produces a JPG with solid
      white filling that corner.
    </p>

    <h2>Assumptions and limitations</h2>
    <ul>
      <li>JPG has no transparency channel — transparent or semi-transparent pixels are flattened onto the background color you choose.</li>
      <li>JPG compression is lossy and not reversible; some detail is lost even at high quality.</li>
      <li>Only the first frame of an animated WebP is converted.</li>
    </ul>

    <h2>Accepted inputs</h2>
    <p>One WebP, up to 25 MB and about 40 million pixels. The background color for transparent pixels starts at white.</p>

    <h2>When the file leaves your device</h2>
    <p>
      Choosing a file and seeing the preview keeps it on your device. It stays there while "Process on your device (default)" is selected. The file is sent only if you select "Upload to our server for processing" and then press Convert. The server holds that file in memory for the one request and does not write it to disk. A failure on your device does not upload the file by itself.
    </p>
  </Fragment>
</ToolLayout>
