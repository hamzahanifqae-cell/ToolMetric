---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CategoryToolGrid from "../../../components/CategoryToolGrid.astro";
import { CATEGORIES, getToolsByCategory } from "../../../content/tools.js";
import { siteConfig } from "../../../config/site.js";
import { breadcrumbJsonLd, itemListJsonLd } from "../../../lib/structuredData.js";

const category = CATEGORIES.converters;
const tools = getToolsByCategory("converters");
---

<BaseLayout title={category.heading} description={category.description} keywords={category.keywords} jsonLd={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "All Tools", path: "/tools/" }, { name: category.label }], siteConfig.url), itemListJsonLd(category.heading, tools, siteConfig.url)]}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: "Home", path: "/" }, { label: "All Tools", path: "/tools/" }, { label: category.label }]} />
    <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">{category.heading}</h1>
    <p class="mt-2 max-w-2xl text-navy-600">{category.description}</p>
    <p class="mt-3 max-w-2xl text-sm text-navy-600">
      Length covers millimeters through miles. Area covers square millimeters through square miles, including acres and hectares.
      Mass converts kilograms, pounds, grams, ounces, stone, and tonnes. Temperature converts Celsius, Fahrenheit, and Kelvin.
      Pick the matching card, enter one number, and choose the two units.
    </p>
    <CategoryToolGrid tools={tools} />
  </div>
</BaseLayout>
