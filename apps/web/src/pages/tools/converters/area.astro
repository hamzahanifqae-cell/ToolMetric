---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { AreaConverter } from "../../../components/converters/AreaConverter.js";
import { getToolByPath } from "../../../content/tools.js";

const tool = getToolByPath("/tools/converters/area")!;

// Chart values come from the same square-meter factors listed in the table below.
const M2 = { ft2: 0.09290304, yd2: 0.83612736, acre: 4046.8564224, ha: 10000, km2: 1000000, mi2: 2589988.110336, m2: 1 };
const fmtArea = (n: number) => n.toLocaleString("en-US", { maximumFractionDigits: n < 1 ? 6 : 4 });
const areaChart: [string, keyof typeof M2, string, keyof typeof M2][] = [
  ["1 acre", "acre", "square feet", "ft2"],
  ["1 acre", "acre", "square meters", "m2"],
  ["1 acre", "acre", "hectares", "ha"],
  ["1 hectare", "ha", "acres", "acre"],
  ["1 hectare", "ha", "square feet", "ft2"],
  ["1 square meter", "m2", "square feet", "ft2"],
  ["1 square foot", "ft2", "square meters", "m2"],
  ["1 square yard", "yd2", "square feet", "ft2"],
  ["1 square kilometer", "km2", "acres", "acre"],
  ["1 square kilometer", "km2", "hectares", "ha"],
  ["1 square mile", "mi2", "acres", "acre"],
  ["1 square mile", "mi2", "square kilometers", "km2"],
];
const areaChartRows = areaChart.map(([from, f, toLabel, t]) => ({ from, to: `${fmtArea(M2[f] / M2[t])} ${toLabel}` }));
---

<ToolLayout
  tool={tool}
  purpose="Area converter for acres, square feet, square meters, hectares, and square miles."
>
  <AreaConverter client:load />

  <Fragment slot="details">
    <h2>Supported units</h2>
    <p>Every conversion multiplies by the factor below to reach square meters, then divides by the target unit's factor.</p>
    <table>
      <caption>Square meters in one of each unit</caption>
      <thead>
        <tr>
          <th scope="col">Unit</th>
          <th scope="col">Square meters</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>Square millimeter (mm²)</td>
          <td>0.000001</td>
        </tr>
        <tr>
          <td>Square centimeter (cm²)</td>
          <td>0.0001</td>
        </tr>
        <tr>
          <td>Square meter (m²)</td>
          <td>1</td>
        </tr>
        <tr>
          <td>Hectare (ha)</td>
          <td>10,000</td>
        </tr>
        <tr>
          <td>Square kilometer (km²)</td>
          <td>1,000,000</td>
        </tr>
        <tr>
          <td>Square foot (ft²)</td>
          <td>0.09290304</td>
        </tr>
        <tr>
          <td>Square yard (yd²)</td>
          <td>0.83612736</td>
        </tr>
        <tr>
          <td>Acre (ac)</td>
          <td>4,046.8564224</td>
        </tr>
        <tr>
          <td>Square mile (mi²)</td>
          <td>2,589,988.110336</td>
        </tr>
      </tbody>
    </table>

    <h2 id="area-conversion-chart">Area conversion chart</h2>
    <p>Common land and floor area conversions, calculated from the factors above.</p>
    <table>
      <caption>Area conversion table</caption>
      <thead>
        <tr>
          <th scope="col">From</th>
          <th scope="col">Equals</th>
        </tr>
      </thead>
      <tbody>
        {areaChartRows.map((row) => (
          <tr>
            <td>{row.from}</td>
            <td>{row.to}</td>
          </tr>
        ))}
      </tbody>
    </table>

    <h2>Accepted inputs</h2>
    <p>
      One number and any two units from the table. The page opens on 1 square meter converted to square feet. Zero stays zero. The factors describe positive area; the result line shows at most six decimal places.
    </p>

    <h2>How to read the result</h2>
    <p>
      10.76391 square feet is the displayed value of 1 square meter, from the exact factor 0.09290304 square meters per square foot. 43,560 square feet per acre is exact. A rounded display is not a second conversion factor.
    </p>

    <h2>How it works</h2>
    <p>
      Every unit is converted through square meters as a common base, then into your target unit, so every
      conversion pair stays mathematically consistent. Distances use the
      <a href="/tools/converters/length/">length converter</a>.
    </p>

    <h2>Worked example</h2>
    <p>
      The converter opens on 1 square meter, which it shows as 10.76391 square feet. One acre is exactly 43,560 square
      feet, 4,046.856422 square meters, and 0.404686 hectares at the same six-decimal display. One hectare is 2.471054
      acres at that display.
    </p>

    <h2>Assumptions and limitations</h2>
    <ul>
      <li>Conversion factors use standard international definitions (e.g. 1 acre = 4,046.8564224 m² exactly).</li>
      <li>Results are rounded for display; internal calculations retain full floating-point precision.</li>
    </ul>

    <h2>Reference</h2>
    <p>Area conversion factors follow NIST Handbook 44, the standard US reference for weights and measures.</p>
  </Fragment>
</ToolLayout>
