---
import ToolLayout from "../../../layouts/ToolLayout.astro";
import { LengthConverter } from "../../../components/converters/LengthConverter.js";
import { getToolByPath } from "../../../content/tools.js";

const tool = getToolByPath("/tools/converters/length")!;
---

<ToolLayout
  tool={tool}
  purpose="Length converter for centimeters, inches, feet, meters, yards, miles, and millimeters."
>
  <LengthConverter client:load />

  <Fragment slot="details">
    <h2>Common length conversions</h2>
    <table>
      <caption>Length factors used by this converter</caption>
      <thead>
        <tr>
          <th scope="col">From</th>
          <th scope="col">Equals</th>
        </tr>
      </thead>
      <tbody>
        <tr>
          <td>1 inch</td>
          <td>2.54 centimeters</td>
        </tr>
        <tr>
          <td>1 centimeter</td>
          <td>0.393701 inches (rounded)</td>
        </tr>
        <tr>
          <td>1 foot</td>
          <td>0.3048 meters</td>
        </tr>
        <tr>
          <td>1 meter</td>
          <td>3.28084 feet (rounded)</td>
        </tr>
        <tr>
          <td>1 mile</td>
          <td>1.609344 kilometers</td>
        </tr>
      </tbody>
    </table>

    <h2>How it works</h2>
    <p>
      Every unit is converted through meters as a common base (e.g. 1 inch = 0.0254 meters, per the international
      yard-and-pound agreement), then from meters into your target unit. This two-step approach keeps every
      conversion pair mathematically consistent. Surface measurements use the
      <a href="/tools/converters/area">area converter</a> instead.
    </p>

    <h2>Worked example</h2>
    <p>1 meter = 3.28084 feet. 10 miles = 16.09344 kilometers.</p>

    <h2>Assumptions and limitations</h2>
    <ul>
      <li>Conversion factors use standard SI/imperial definitions and are exact to the precision shown.</li>
      <li>Results are rounded for display; very large or very small values may show fewer significant digits due to floating-point precision limits inherent to JavaScript numbers.</li>
    </ul>

    <h2>Reference</h2>
    <p>
      Conversion factors follow NIST Special Publication 811 (<em>Guide for the Use of the International System of
      Units</em>) and NIST Handbook 44, the standard references for SI and customary unit conversions in the US.
    </p>
  </Fragment>
</ToolLayout>
