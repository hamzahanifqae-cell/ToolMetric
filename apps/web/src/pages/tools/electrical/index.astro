---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import CategoryToolGrid from "../../../components/CategoryToolGrid.astro";
import { CATEGORIES, getToolsByCategory } from "../../../content/tools.js";

const category = CATEGORIES.electrical;
const tools = getToolsByCategory("electrical");
---

<BaseLayout title={category.label} description={category.description}>
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: "All Tools", path: "/tools" }, { label: category.label }]} />
    <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">{category.label}</h1>
    <p class="mt-2 max-w-2xl text-navy-600">{category.description}</p>
    <CategoryToolGrid tools={tools} />
  </div>
</BaseLayout>
