---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Breadcrumbs from "../../components/Breadcrumbs.astro";
import { ToolSearch } from "../../components/ToolSearch.js";
---

<BaseLayout title="All Tools" description="Browse and search every tool: image tools, everyday calculators, unit converters, and electrical calculators.">
  <div class="mx-auto max-w-6xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: "All Tools" }]} />
    <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">All Tools</h1>
    <p class="mt-2 max-w-2xl text-navy-600">Search or filter by category to find the tool you need.</p>
    <div class="mt-6">
      <ToolSearch client:load />
    </div>
  </div>
</BaseLayout>
