---
import { ToolCard } from "../components/ToolCard.js";
import BaseLayout from "../layouts/BaseLayout.astro";
import { CATEGORIES, TOOLS } from "../content/tools.js";
import { siteConfig } from "../config/site.js";
import { itemListJsonLd, websiteJsonLd } from "../lib/structuredData.js";

const homeDescription =
  "Free online percentage calculator, age calculator, PNG to JPG converter, image compressor, Celsius to Fahrenheit, kg to lbs, and Ohm's law tools.";
const popularTools = [
  { href: "/tools/calculators/percentage", label: "Percentage calculator" },
  { href: "/tools/calculators/age", label: "Age calculator" },
  { href: "/tools/calculators/date-difference", label: "Days between dates" },
  { href: "/tools/calculators/discount", label: "Discount calculator" },
  { href: "/tools/image/png-to-jpg", label: "PNG to JPG" },
  { href: "/tools/image/to-webp", label: "JPG to WebP" },
  { href: "/tools/image/webp-to-jpg", label: "WebP to JPG" },
  { href: "/tools/image/compressor", label: "Compress image" },
  { href: "/tools/image/resizer", label: "Resize image" },
  { href: "/tools/converters/length", label: "CM to inches" },
  { href: "/tools/converters/mass", label: "KG to lbs" },
  { href: "/tools/converters/temperature", label: "Celsius to Fahrenheit" },
  { href: "/tools/electrical/ohms-law", label: "Ohm's law calculator" },
  { href: "/tools/electrical/power", label: "Watts calculator" },
  { href: "/tools/electrical/energy-cost", label: "Electricity cost calculator" },
];

const featuredPaths = [
  "/tools/image/compressor",
  "/tools/calculators/percentage",
  "/tools/converters/temperature",
  "/tools/electrical/ohms-law",
  "/tools/calculators/age",
  "/tools/image/resizer",
];
const featured = featuredPaths.map((p) => TOOLS.find((t) => t.path === p)).filter(Boolean);
const categories = Object.values(CATEGORIES);
---

<BaseLayout
  title="Free Calculators, Converters and Image Tools"
  description={homeDescription}
  keywords={popularTools.map((tool) => tool.label.toLowerCase())}
  jsonLd={[websiteJsonLd(siteConfig.name, siteConfig.url, homeDescription), itemListJsonLd("Free online tools", TOOLS, siteConfig.url)]}
>
  <section class="home-hero">
    <div class="hero-shell">
      <div class="hero-copy">
        <p class="eyebrow"><span></span> FREE ONLINE TOOLS</p>
        <h1>Free tools.<br/><span>Sorted.</span></h1>
        <p class="hero-description">Convert PNG to JPG, work out a percentage, or change Celsius to Fahrenheit. Practical tools that get you straight to the answer.</p>
        <div class="hero-actions"><a href="/tools" class="primary-action">Find your tool <span aria-hidden="true">↓</span></a><a href="/tools" class="secondary-action">Explore all {TOOLS.length} tools ↗</a></div>
        <div class="hero-notes"><span>✓ No account needed</span><span>✓ Free to use</span></div>
      </div>
      <div class="hero-workbench" aria-label="Featured tool shortcuts">
        <div class="workbench-top"><span class="workbench-symbol" aria-hidden="true">⌘</span><span>Less effort. More done.</span><span class="workbench-tag">TOOLKIT</span></div>
        <a class="workbench-feature" href="/tools/image/compressor"><span class="visual-icon" aria-hidden="true">▧</span><div><span class="mini-label">MAKE ROOM FOR MORE</span><h2>Smaller images.<br/>Ready to share.</h2><span class="feature-link">Open image compressor ↗</span></div></a>
        <div class="workbench-pair"><a href="/tools/calculators/percentage"><span class="pair-symbol" aria-hidden="true">%</span><strong>Numbers, simplified.</strong><span>Percentage calculator ↗</span></a><a href="/tools/electrical/ohms-law"><span class="pair-symbol" aria-hidden="true">Ω</span><strong>Make the connection.</strong><span>Ohm’s law calculator ↗</span></a></div>
        <div class="workbench-bottom"><span>Built for the task at hand</span><span>01 — 18</span></div>
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
    <h2 class="text-xl font-bold text-navy-900">A good place to start</h2>
    <ul class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        featured.map((tool) => (
          <li>
            <ToolCard title={tool!.title} href={tool!.path} category={tool!.category} icon={tool!.slug} />
          </li>
        ))
      }
    </ul>
  </section>

  <section class="border-t border-sand-200">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-bold text-navy-900">Tools people look up</h2>
      <ul class="mt-4 flex flex-wrap gap-2">
        {
          popularTools.map((tool) => (
            <li>
              <a
                href={tool.href}
                class="inline-block rounded-full border border-sand-300 bg-white px-3 py-1.5 text-sm font-medium text-navy-800 hover:border-teal-300 hover:bg-teal-50"
              >
                {tool.label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <section class="border-t border-sand-200 bg-sand-50">
    <div class="mx-auto max-w-6xl px-4 py-12 sm:px-6">
      <h2 class="text-xl font-bold text-navy-900">The right tools, together.</h2>
      <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {
          categories.map((cat) => (
            <ToolCard title={cat.heading} href={cat.path} category={cat.key} />
          ))
        }
      </div>
    </div>
  </section>

  <section class="mx-auto max-w-4xl px-4 py-12 sm:px-6">
    <h2 class="text-xl font-bold text-navy-900">How processing works</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-lg border border-sand-200 bg-white p-5">
        <p class="font-semibold text-navy-900">Calculators and converters</p>
        <p class="mt-2 text-sm text-navy-600">
          All percentage, age, date, unit, and electrical calculations run entirely in your browser using JavaScript.
          No values you enter are sent to a server.
        </p>
      </div>
      <div class="rounded-lg border border-sand-200 bg-white p-5">
        <p class="font-semibold text-navy-900">Image tools</p>
        <p class="mt-2 text-sm text-navy-600">
          Image conversion, compression, and resizing default to processing on your device. Each image tool also
          offers an explicitly labelled option to upload the file to our server instead, which is useful if your
          browser doesn't support a particular operation.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>
