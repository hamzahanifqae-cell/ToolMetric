---
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { siteConfig } from "../config/site.js";
import { breadcrumbJsonLd } from "../lib/structuredData.js";
---

<BaseLayout
  title="Privacy Policy"
  description={`How ${siteConfig.name} handles data for calculators, converters, and image tools.`}
  thirdPartyScripts={false}
  jsonLd={[breadcrumbJsonLd([{ name: "Home", path: "/" }, { name: "Privacy Policy" }], siteConfig.url)]}
>
  <div class="mx-auto max-w-3xl px-4 py-10 sm:px-6">
    <Breadcrumbs items={[{ label: "Home", path: "/" }, { label: "Privacy Policy" }]} />
    <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">Privacy Policy</h1>

    <div class="prose-tool mt-6">
      <h2>Calculators and unit converters</h2>
      <p>
        Every calculator and unit converter on {siteConfig.name} (percentage, age, date, discount, length, mass,
        temperature, area, and all electrical calculators) runs entirely in your browser. The values you type are
        never transmitted to our server or anywhere else.
      </p>

      <h2>Image tools</h2>
      <p>
        Image tools default to local, in-browser processing: your file is decoded and converted on your device and
        is never uploaded. Each image tool also offers an explicitly labelled "Upload to our server for processing"
        option. If you choose that option:
      </p>
      <ul>
        <li>Your file is uploaded to our API over HTTPS (in production) and held only in memory — in an isolated worker process — for the duration of that one request.</li>
        <li>Nothing is written to disk during normal operation. The in-memory buffer and its worker are discarded as soon as the request finishes, fails, times out, or is cancelled (including if you close the tab mid-upload); none of it persists afterward.</li>
        <li>As a defensive safety net only (not the normal mechanism), the server also runs a startup and periodic sweep of its temporary-file directory, in case a future bug or crash ever left a stray file there.</li>
        <li>We do not log the contents of uploaded files or the filenames you upload.</li>
      </ul>
      <p>
        Choosing local processing means the file itself never leaves your device — but it does not, by itself,
        prevent our hosting provider or any advertising service (if and when enabled) from collecting other data
        about your visit, such as standard web server access logs or ad-related data. Those are separate from the
        file-processing behavior described above.
      </p>

      <h2>Cookies and analytics</h2>
      {
        siteConfig.gaMeasurementId ? (
          <p>
            This site uses Google Analytics 4 to count visits: which pages are opened, the general location and
            device, and how someone arrived. The numbers you type into a calculator and the images you convert are
            not sent to Analytics. Google may store a cookie such as <code>_ga</code> in your browser for this.
            Google's description of this data is at{" "}
            <a href="https://policies.google.com/privacy" class="font-semibold text-teal-700 underline">
              Google's privacy policy
            </a>
            . You can opt out with the{" "}
            <a href="https://tools.google.com/dlpage/gaoptout" class="font-semibold text-teal-700 underline">
              Google Analytics opt-out add-on
            </a>
            .
          </p>
        ) : (
          <p>
            Traffic analytics are not enabled on this site. If that changes, this policy will describe what is
            collected before the tracking tag is published.
          </p>
        )
      }

      <h2>Advertising</h2>
      <p>Google AdSense is the only advertising service on this site. No other ad network serves ads here.</p>
      <p>
        Third-party vendors, including Google, use cookies to serve ads based on prior visits to this site or other
        sites.
      </p>
      <p>
        Google's advertising cookies allow Google and its partners to use those visits to select ads.
      </p>
      <p>
        The numbers you type into a calculator, and the contents of an image you convert, are not sent to the ad
        service. The ad tag can still receive the address of a tool page you opened. This privacy page does not
        load the AdSense script or the Analytics tag.
      </p>
      <p>
        You can review and change personalized ads in{" "}
        <a href="https://myadcenter.google.com/" class="font-semibold text-teal-700 underline">Google's Ad Center</a>.
      </p>

      <h2>Hosting costs</h2>
      <p>
        No paid conversion APIs are used by this site. Running it still involves ordinary hosting, bandwidth, and
        domain costs, which are unrelated to how your data is processed.
      </p>

      <h2>Contact</h2>
      <p>
        There is no contact form, so this site does not receive or store a message you type.{" "}
        {
          siteConfig.operatorEmail ? (
            <>
              Questions about this policy can be sent to{" "}
              <a href={`mailto:${siteConfig.operatorEmail}`} class="font-semibold text-teal-700 underline">
                {siteConfig.operatorEmail}
              </a>
              .
            </>
          ) : (
            <>No public email address is listed. The <a href="/contact/">contact page</a> says the same thing.</>
          )
        }
      </p>
    </div>
  </div>
</BaseLayout>
