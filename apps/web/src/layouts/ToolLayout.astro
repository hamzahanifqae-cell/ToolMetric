---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { CATEGORIES, getRelatedTools, type ToolMeta } from "../content/tools.js";
import { siteConfig } from "../config/site.js";

interface Props {
  tool: ToolMeta;
  description: string;
  purpose: string;
}

const { tool, description, purpose } = Astro.props;
const category = CATEGORIES[tool.category];
const related = getRelatedTools(tool);

const breadcrumbJsonLd = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    { "@type": "ListItem", position: 1, name: "All Tools", item: new URL("/tools", siteConfig.url).toString() },
    { "@type": "ListItem", position: 2, name: category.label, item: new URL(category.path, siteConfig.url).toString() },
    { "@type": "ListItem", position: 3, name: tool.title, item: new URL(tool.path, siteConfig.url).toString() },
  ],
};
---

<BaseLayout title={tool.title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumbs
      items={[
        { label: "All Tools", path: "/tools" },
        { label: category.label, path: category.path },
        { label: tool.title },
      ]}
    />

    <header class="mb-6">
      <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">{tool.title}</h1>
      <p class="mt-2 max-w-3xl text-navy-600">{purpose}</p>
    </header>

    <section aria-label={`${tool.title} tool`} class="rounded-xl border border-sand-200 bg-white p-4 shadow-sm sm:p-6">
      <slot />
    </section>

    <section class="prose-tool mt-10 max-w-3xl">
      <slot name="details" />
    </section>

    {
      related.length > 0 && (
        <nav aria-label="Related tools" class="mt-12 border-t border-sand-200 pt-8">
          <h2 class="text-lg font-semibold text-navy-900">Related tools</h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-3">
            {related.map((r) => (
              <li>
                <a
                  href={r.path}
                  class="block rounded-lg border border-sand-200 bg-white p-3 text-sm font-medium text-navy-800 hover:border-teal-300 hover:bg-teal-50"
                >
                  {r.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .prose-tool :global(h2) {
    margin-top: 2rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .prose-tool :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-tool :global(p) {
    margin-top: 0.5rem;
    color: var(--color-navy-700);
    line-height: 1.65;
  }
  .prose-tool :global(ul) {
    margin-top: 0.5rem;
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-navy-700);
  }
  .prose-tool :global(li) {
    margin-top: 0.25rem;
  }
  .prose-tool :global(code) {
    border-radius: 0.25rem;
    background-color: var(--color-sand-100);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    color: var(--color-navy-900);
  }
</style>
