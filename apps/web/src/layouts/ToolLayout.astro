---
import BaseLayout from "./BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { getToolFaqs } from "../content/faqs.js";
import { CATEGORIES, getRelatedTools, type ToolMeta } from "../content/tools.js";
import { siteConfig } from "../config/site.js";
import { breadcrumbJsonLd, faqPageJsonLd, webApplicationJsonLd } from "../lib/structuredData.js";

interface Props {
  tool: ToolMeta;
  purpose: string;
}

const { tool, purpose } = Astro.props;
const category = CATEGORIES[tool.category];
const related = getRelatedTools(tool);
const faqs = getToolFaqs(tool.slug);

const jsonLd = [
  breadcrumbJsonLd(
    [
      { name: "All Tools", path: "/tools" },
      { name: category.label, path: category.path },
      { name: tool.title, path: tool.path },
    ],
    siteConfig.url,
  ),
  webApplicationJsonLd(tool, siteConfig.url),
  ...(faqs.length > 0 ? [faqPageJsonLd(faqs)] : []),
];
---

<BaseLayout title={tool.title} description={tool.metaDescription} keywords={tool.keywords} jsonLd={jsonLd}>
  <div class="mx-auto max-w-5xl px-4 py-8 sm:px-6 sm:py-10">
    <Breadcrumbs
      items={[
        { label: "All Tools", path: "/tools" },
        { label: category.label, path: category.path },
        { label: tool.title },
      ]}
    />

    <header class="mb-6">
      <h1 class="text-2xl font-bold text-navy-900 sm:text-3xl">{tool.title}</h1>
      <p class="mt-2 max-w-3xl text-navy-600">{purpose}</p>
    </header>

    <section aria-label={`${tool.title} tool`} class="rounded-xl border border-sand-200 bg-white p-4 shadow-sm sm:p-6">
      <slot />
    </section>

    <section class="prose-tool mt-10 max-w-3xl">
      <slot name="details" />
    </section>

    {
      faqs.length > 0 && (
        <section class="prose-tool mt-10 max-w-3xl" aria-labelledby="tool-faq-heading">
          <h2 id="tool-faq-heading">Common questions</h2>
          {faqs.map((faq) => (
            <div>
              <h3>{faq.question}</h3>
              <p>{faq.answer}</p>
            </div>
          ))}
        </section>
      )
    }

    {
      related.length > 0 && (
        <nav aria-label="Related tools" class="mt-12 border-t border-sand-200 pt-8">
          <h2 class="text-lg font-semibold text-navy-900">Related tools</h2>
          <ul class="mt-3 grid gap-3 sm:grid-cols-3">
            {related.map((r) => (
              <li>
                <a
                  href={r.path}
                  class="block rounded-lg border border-sand-200 bg-white p-3 text-sm font-medium text-navy-800 hover:border-teal-300 hover:bg-teal-50"
                >
                  {r.title}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )
    }
  </div>
</BaseLayout>

<style>
  .prose-tool :global(h2) {
    margin-top: 2rem;
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--color-navy-900);
  }
  .prose-tool :global(h2:first-child) {
    margin-top: 0;
  }
  .prose-tool :global(h3) {
    margin-top: 1.25rem;
    font-size: 1rem;
    font-weight: 600;
    color: var(--color-navy-900);
  }
  .prose-tool :global(p) {
    margin-top: 0.5rem;
    color: var(--color-navy-700);
    line-height: 1.65;
  }
  .prose-tool :global(ul) {
    margin-top: 0.5rem;
    list-style: disc;
    padding-left: 1.25rem;
    color: var(--color-navy-700);
  }
  .prose-tool :global(li) {
    margin-top: 0.25rem;
  }
  .prose-tool :global(a) {
    color: var(--color-teal-800);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .prose-tool :global(code) {
    border-radius: 0.25rem;
    background-color: var(--color-sand-100);
    padding: 0.125rem 0.375rem;
    font-size: 0.875em;
    color: var(--color-navy-900);
  }
</style>
