# Copy this file to .env and adjust before deploying. Never commit a real .env file.
# All PUBLIC_* variables are exposed to the browser bundle — never put secrets here.
#
# PUBLIC_SITE_URL is required for the standard release build (`npm run
# build`) and for `npm run launch-check` to pass. Without it, `npm run
# build` fails on purpose — it never silently falls back to localhost for a
# release. For a non-release build (previewing dist/ output locally, no
# real domain needed yet), use `npm run build:local` instead.
# PUBLIC_OPERATOR_NAME/PUBLIC_OPERATOR_EMAIL are optional (see below) and
# are not required for the release build to pass.

# Required for a real release: the real public HTTPS domain this site will be
# served from. Used for canonical URLs, the sitemap, robots.txt, and
# structured data. Must be: HTTPS only (no plain HTTP); a registered domain
# name, not an IP address of any kind (loopback, private, link-local, or
# public); not localhost or a reserved documentation/example domain
# (example.com, *.test, *.invalid, *.localhost, or any subdomain of those);
# the site root only — no path, query string, fragment, or embedded
# credentials. Checked by the same validator in astro.config.mjs,
# src/config/site.ts, and scripts/launch-check.mjs.
# PUBLIC_SITE_URL=https://yourdomain.com

PUBLIC_SITE_NAME=ToolMetric

# Public operator name and contact email — entirely optional. Leaving both
# unset is a fully supported choice if you don't want to publish an
# operator identity; the About/Privacy pages just say no public contact is
# listed, rather than inventing a placeholder. If you DO set
# PUBLIC_OPERATOR_EMAIL, it's checked for valid syntax (and rejected if
# it's an obvious placeholder like you@example.com) — this does NOT confirm
# the mailbox actually exists or receives mail, only that it's a
# well-formed, non-placeholder address.
# PUBLIC_OPERATOR_NAME=
# PUBLIC_OPERATOR_EMAIL=

# Set to "noindex" for an intentional staging deployment (a real HTTPS domain
# that isn't the final public one yet). Leave unset — or "index" — for the
# actual public launch; omitting it is the correct default, not an oversight.
# Produces both a disallow-all robots.txt and a noindex meta tag on every page.
# PUBLIC_ROBOTS_POLICY=noindex

# Google Search Console ownership token. This is public — it is printed in
# the homepage <head> as <meta name="google-site-verification"> — and it is
# not an API key or a secret. Leave it unset until Search Console gives you
# one. Paste either the bare content value, or the whole meta tag Google
# shows. Then rebuild and deploy before you click Verify.
#
# Steps: https://search.google.com/search-console
#   1. Add property → URL prefix → https://toolmetric.online/
#   2. Verify with the HTML tag method.
#   3. Put the token here, rebuild, deploy, then click Verify.
#   4. Submit https://toolmetric.online/sitemap-index.xml
# A Domain property (toolmetric.online, all hosts) is verified with a DNS
# TXT record instead, and does not need this variable.
# PUBLIC_GOOGLE_SITE_VERIFICATION=

# Advertising is disabled by default and must stay disabled until a real,
# approved AdSense configuration exists. Do not set a real client ID here
# until you have read Google's current publisher policies and are ready to
# request review. A missing client ID never blocks an otherwise valid,
# ad-free release — see README.
PUBLIC_ADSENSE_ENABLED=false
# PUBLIC_ADSENSE_CLIENT_ID=

# Dev-server-only: where to proxy /api/* requests to (the Fastify API service).
API_PROXY_TARGET=http://localhost:8787

# Leave unset for the normal same-origin setup (a reverse proxy forwards
# /api/* on this site's own origin to the API — true in dev via
# API_PROXY_TARGET above, and in most production reverse-proxy setups).
# Only set this to an absolute origin if the API is genuinely deployed on a
# different origin than the site (e.g. a separate subdomain) — see
# DEPLOY_CPANEL.md for when this applies. Also requires the API's
# CORS_ORIGIN to be set to this site's origin.
# PUBLIC_API_BASE_URL=https://api.yourdomain.com
